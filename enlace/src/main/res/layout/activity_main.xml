<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Solo mientras el S40 busca este teléfono. -->
    <Button
        android:id="@+id/finding_banner"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginBottom="16dp"
        android:background="#D32F2F"
        android:text="@string/find_banner"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

    <Button
        android:id="@+id/toggle"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="24dp"
        android:textAllCaps="false"
        android:textSize="20sp" />

    <Button
        android:id="@+id/find_s40"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="12dp"
        android:text="@string/find_s40"
        android:textAllCaps="false"
        android:textSize="18sp" />

    <Button
        android:id="@+id/show_s40_location"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="12dp"
        android:text="@string/show_s40_location"
        android:textAllCaps="false"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/listener_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

    <Button
        android:id="@+id/listener_access"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        android:text="@string/listener_access"
        android:textAllCaps="false"
        android:textSize="18sp" />

    <Button
        android:id="@+id/choose_apps"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        android:text="@string/choose_apps"
        android:textAllCaps="false"
        android:textSize="18sp" />

    <Button
        android:id="@+id/probe_audio"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        android:text="@string/probe_audio"
        android:textAllCaps="false"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/probe_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />
</LinearLayout>

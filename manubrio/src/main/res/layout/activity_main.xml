<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/watch_case"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/screen_half"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="6dp"
        android:layout_weight="0.55">

    <LinearLayout
        android:id="@+id/info_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/info_panel_background"
        android:contentDescription="@string/ride_long_press_hint"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Franja LCD: hora y lo que suena, con píxeles oscuros. -->
        <com.rodada.app.LedTickerView
            android:id="@+id/ticker"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="0.22"
            android:background="@drawable/ticker_background"
            android:contentDescription="@string/ticker_description"
            android:paddingStart="8dp"
            android:paddingTop="5dp"
            android:paddingEnd="8dp"
            android:paddingBottom="5dp" />

        <LinearLayout
            android:id="@+id/speed_block"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.55"
            android:orientation="vertical">

            <com.rodada.app.LedTextView
                android:id="@+id/speed"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.rodada.app.LedTextView
                android:id="@+id/speed_unit"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="4dp"
                android:text="@string/speed_unit" />
        </LinearLayout>

        <!-- Navegación de Google Maps del Motorola: reemplaza velocidad y distancia. -->
        <LinearLayout
            android:id="@+id/nav_block"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.80"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.rodada.app.NavArrowView
                    android:id="@+id/nav_arrow"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.45" />

                <com.rodada.app.LedTextView
                    android:id="@+id/nav_distance"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="0.55" />
            </LinearLayout>

            <com.rodada.app.LedTextView
                android:id="@+id/nav_instruction"
                android:layout_width="match_parent"
                android:layout_height="40dp" />

            <com.rodada.app.LedTextView
                android:id="@+id/nav_summary"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/stats_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.25"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.rodada.app.LedTextView
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:text="@string/distance_label" />

                <com.rodada.app.LedTextView
                    android:id="@+id/distance"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:layout_marginTop="4dp"
                    android:paddingEnd="10dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.rodada.app.LedTextView
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:text="@string/elapsed_label" />

                <com.rodada.app.LedTextView
                    android:id="@+id/elapsed"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:layout_marginTop="4dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="2dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

        <com.rodada.app.LedTextView
            android:id="@+id/unread_badge"
            android:layout_width="56dp"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:visibility="gone" />

        <!-- Notificación del Motorola: tapa la pantallita; un toque la lee. -->
        <LinearLayout
            android:id="@+id/notice"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/notice_background"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <com.rodada.app.LedTextView
                android:id="@+id/notice_app"
                android:layout_width="match_parent"
                android:layout_height="22dp" />

            <com.rodada.app.LedTextView
                android:id="@+id/notice_title"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp" />

            <com.rodada.app.LedTextView
                android:id="@+id/notice_text"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/wheel_half"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.45">

        <com.rodada.app.MusicWheelView
            android:id="@+id/music_wheel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/music_wheel_description" />

        <Button
            android:id="@+id/menu_button"
            android:layout_width="68dp"
            android:layout_height="36dp"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:background="@drawable/button_outline"
            android:contentDescription="@string/menu_description"
            android:padding="0dp"
            android:text="@string/menu_icon"
            android:textColor="@color/silver_ink"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/target_status"
            android:layout_width="96dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="8dp"
            android:textColor="#D5D8D6"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/link_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:textColor="#D5D8D6"
            android:textSize="13sp"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>
